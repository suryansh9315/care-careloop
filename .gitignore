# Never commit real credentials — see the .example files
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key

# Live workspace configuration: machine-specific absolute paths, generated by the
# care_scaffold helper. Tracked as .example files only.
workspace/paths.env
workspace/frontend.env

# --- Node: the legacy TS core, and the frontend plugin ---
node_modules/
dist/
coverage/
*.tsbuildinfo

# --- Python: the backend plugin ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Terraform state can contain secrets (legacy deploy, retired with the bridge)
legacy/deploy/terraform/.terraform/
legacy/deploy/terraform/*.tfstate
legacy/deploy/terraform/*.tfstate.*
legacy/deploy/terraform/*.tfvars
!legacy/deploy/terraform/*.tfvars.example

.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/
